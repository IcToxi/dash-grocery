{
  "name": "dash_grocery",
  "version": "0.3.0",
  "description": "Dash components wrapping useful React libraries.",
  "repository": {
    "type": "git",
    "url": "https://github.com/IcToxi/dash-grocery.git"
  },
  "bugs": {
    "url": "https://github.com/IcToxi/dash-grocery/issues"
  },
  "homepage": "https://github.com/IcToxi/dash-grocery",
  "main": "build/index.js",
  "scripts": {
    "start": "webpack --mode development --watch",
    "lint": "eslint src/lib",
    "validate-init": "python _validate_init.py",
    "prepublishOnly": "yarn run validate-init",
    "build:js": "webpack --mode production",
    "build:py_and_r": "dash-generate-components ./src/lib/components dash_grocery -p package-info.json --r-prefix ''",
    "build:py_and_r-activated": "(. venv/bin/activate || venv\\scripts\\activate && yarn run build:py_and_r)",
    "build": "yarn run build:js && yarn run build:py",
    "build:py": "dash-generate-components ./src/lib/components dash_grocery -p package-info.json",
    "build_no_r": "yarn run build",
    "build:activated": "yarn run build:js && yarn run build:py_and_r-activated"
  },
  "author": "IcToxi",
  "license": "MIT",
  "dependencies": {
    "@tsparticles/engine": "^4.5.1",
    "@tsparticles/react": "^4.5.1",
    "@tsparticles/slim": "^4.5.1",
    "moment": "^2.31.0",
    "moment-timezone": "^0.6.6",
    "qrcode.react": "^4.2.0",
    "ramda": "^0.32.0",
    "react-barcode": "^1.6.1",
    "react-grid-layout": "^1.5.4",
    "react-open-weather": "^1.3.9",
    "react-resizable": "^4.0.2"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@babel/eslint-parser": "^8.0.7",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@eslint/js": "^9",
    "@plotly/dash-component-plugins": "^1.2.3",
    "@plotly/webpack-dash-dynamic-import": "^1.3.0",
    "babel-loader": "^10.1.1",
    "css-loader": "^7.1.5",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.14.0",
    "node-polyfill-webpack-plugin": "^4.1.0",
    "prop-types": "^15.8.1",
    "react": "19.3.1",
    "react-docgen": "^5.4.3",
    "react-dom": "19.3.1",
    "style-loader": "^4.0.0",
    "webpack": "^5.112.2",
    "webpack-cli": "^5.1.4"
  },
  "engines": {
    "node": ">=16.15.0",
    "npm": ">=8.5.10",
    "yarn": ">=4.2.2"
  },
  "packageManager": "yarn@4.2.2"
}
